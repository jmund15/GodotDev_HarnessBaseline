{
  "disableClaudeAiConnectors": true,
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "context7@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": false
  },
  "env": {
    "CLAUDE_CODE_GLOB_NO_IGNORE": "false",
    "PYTHONUTF8": "1"
  },
  "hooks": {
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/log_instruction_loads.py\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/denial_coach.py\" --record",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_edit_dispatch.py\"",
            "timeout": 45,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      },
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/runaway_scan_reaper.py\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^(?:Agent|Workflow|TaskStop|TaskOutput|Skill|ToolSearch|LSP|NotebookEdit|mcp__.*)$"
      },
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_read_dispatch.py\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Read|Grep|Glob|Write|WebFetch|WebSearch|mcp__plugin_semantic-search_semantic-search__search|mcp__ai-worker__write_doc"
      },
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/skill_load_marker.py\"",
            "type": "command"
          }
        ],
        "matcher": "Skill"
      },
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/memory_hits_logger.py\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "mcp__ai-worker__read_files"
      },
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch_table.py\" --launch",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Workflow|Agent"
      },
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch_table.py\" --launch",
            "if": "Bash(*_sidecar.sh*)",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch_table.py\" --launch",
            "if": "Bash(*sidecar_fanout.py*)",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/transcript_backup.py\"",
            "timeout": 30,
            "type": "command"
          },
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/compact_directive_ledger.py\"",
            "timeout": 30,
            "type": "command"
          },
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent_compaction_rail.py\"",
            "timeout": 15,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_edit_dispatch.py\"",
            "timeout": 60,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      },
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/kill_guard.py\"",
            "timeout": 20,
            "type": "command"
          }
        ],
        "matcher": "TaskStop"
      },
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/peer_message_guard.py\"",
            "timeout": 20,
            "type": "command"
          }
        ],
        "matcher": "SendMessage"
      },
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_bash_dispatch.py\"",
            "timeout": 75,
            "type": "command"
          },
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/kill_guard.py\"",
            "timeout": 20,
            "type": "command"
          }
        ],
        "matcher": "Bash|PowerShell|Monitor"
      },
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_workflow_dispatch.py\"",
            "timeout": 90,
            "type": "command"
          }
        ],
        "matcher": "Workflow|Agent"
      },
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_read_dispatch.py\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Read|Grep|Glob|Write|WebFetch|WebSearch|mcp__plugin_semantic-search_semantic-search__search"
      },
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/overnight_ask_guard.py\"",
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion"
      },
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/rail_probe_guard.py\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "LSP|NotebookEdit|EnterWorktree|CronCreate|RemoteTrigger|mcp__ai-worker__.*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_context_loader.py\"",
            "timeout": 600,
            "type": "command"
          },
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_model_rails.py\"",
            "timeout": 30,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/compact_directive_anchor.py\"",
            "timeout": 30,
            "type": "command"
          },
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent_compaction_rail.py\"",
            "timeout": 15,
            "type": "command"
          },
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/sidecar_recompact_reprompt.py\"",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch_table.py\" --complete",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/denial_coach.py\" --coach",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/runaway_scan_reaper.py\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  },
  "outputStyle": "terse",
  "permissions": {
    "ask": [
      "Bash(bash .claude/scripts/*_sidecar.sh * -t +Bash *)"
    ],
    "allow": [
