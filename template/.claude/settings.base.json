      "Bash(git cherry-pick:*)",
      "Bash(git clean:*)",
      "Bash(git clone:*)",
      "Bash(git commit:*)",
      "Bash(git config:*)",
      "Bash(git describe:*)",
      "Bash(git diff:*)",
      "Bash(git diff-tree:*)",
