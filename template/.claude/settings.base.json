      "mcp__plugin_context7_context7__query-docs",
      "mcp__plugin_semantic-search_semantic-search__search",
      "mcp__ai-worker__*",
      "Skill(autolearn)",
      "Skill(codify)",
      "Skill(project_subsystems)",
      "Skill(sync_baseline)",
      "Skill(sync_permissions)",
      "Skill(self_evaluate)",
      "Skill(session_end)",
      "Skill(memory_graph)",
      "Skill(commit_push)",
      "Skill(clean_push)",
      "Skill(clean_pull)",
      "Skill(create_pr)",
      "Skill(doc_full)",
      "Skill(doc_architecture)",
      "Skill(doc_retrospective)",
      "Skill(doc_usage)",
      "Skill(eval_dashboard)",
      "Skill(worklog)"
    ],
    "deny": [
      "Read(.claude/worktrees/**)",
      "Grep(.claude/worktrees/**)",
      "Agent",
      "PowerShell",
      "ReportFindings",
      "ScheduleWakeup"
    ]
  },
  "skillOverrides": {
    "claude-api": "user-invocable-only",
    "dataviz": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "init": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "plugin-authoring": "user-invocable-only",
    "run": "user-invocable-only",
    "security-review": "user-invocable-only",
    "simplify": "user-invocable-only",
    "update-config": "user-invocable-only"
  }
}
