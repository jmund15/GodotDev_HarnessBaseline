# Campaign file — OpenCode Zen FREE models through the harness-bounds-v1.2 S/D/F ladders.
# Transport identity only; the battery recipe is battery-owned (lib.sh). Another transport
# is a copy of this file with these keys changed and nothing else.
SDF_LAUNCHER="opencode_sidecar.sh"
# Z = OpenCode Zen. The sealed results use one letter per transport family (C=Claude,
# D=DeepSeek, L=local) and arm ids split on the first dash, so Z-MIMO / Z-MUSE / Z-PICKLE
# read the same way C-HAIKU and D-FLASH already do.
SDF_ARM_FAMILY="Z"
SDF_OUT_NAME="sdf-opencode"
SDF_LOGTAG="opencode-free"
# $0 transport: the band gate rations OUR Claude-plan quota, which these calls never touch,
# and its state file is absent in detached launch envs (measured: every cell rc=5 in
# seconds). -A bypasses only that gate; balance and provider-band gates cannot fire on an
# open-tier $0 row at all.
SDF_DISPATCH_FLAGS="-A"
# One-request liveness probe run before each cell. A refused dispatch on this transport costs
# ~220s (the child retries ten times), so on an exhausted free tier a 17-rung ladder spends an
# hour re-learning one bit. Resolved relative to the suite dir; SDF_NO_PREFLIGHT=1 bypasses.
SDF_PREFLIGHT="preflight_opencode.py"
