#!/bin/sh
# Installed by `git config core.hooksPath .claude/githooks`. Re-runs the stage-record and peer-revert checks at the
# moment git writes the commit: the PreToolUse floor judged the index before the commit hooks ran, and a peer's
# commit can land in between (dangerous_shell_guard.py commit_msg_check). A floor check: a missing prerequisite
# refuses the commit.
root=$(git rev-parse --show-toplevel) || { echo "BLOCKED commit: the commit-msg hook cannot find the repository root to run the peer-revert guard." >&2; exit 1; }
guard="$root/.claude/hooks/dangerous_shell_guard.py"
if [ ! -f "$guard" ]; then
    echo "BLOCKED commit: the peer-revert guard .claude/hooks/dangerous_shell_guard.py is missing. Restore it (git checkout HEAD -- .claude/hooks/dangerous_shell_guard.py), then commit again." >&2
    exit 1
fi
if ! command -v python3 >/dev/null 2>&1; then
    echo "BLOCKED commit: the commit-msg hook cannot find python3 on PATH to run the peer-revert guard. Put python3 on PATH, then commit again." >&2
    exit 1
fi
exec python3 "$guard" --commit-msg "$1"
