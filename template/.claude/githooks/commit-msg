#!/bin/sh
# Installed by `git config core.hooksPath .claude/githooks`. Re-runs the commit checks at the moment git writes the
# commit (pre_bash_dispatch.py commit_time): the stage-record and peer-revert checks, since a peer's commit can land
# after the PreToolUse floor judged the index, then every commit judge on the index git is writing, so an index write
# earlier in the same Bash call is judged too. A floor check: a missing prerequisite refuses the commit.
root=$(git rev-parse --show-toplevel) || { echo "BLOCKED commit: the commit-msg hook cannot find the repository root to run the commit checks." >&2; exit 1; }
entry="$root/.claude/hooks/pre_bash_dispatch.py"
if [ ! -f "$entry" ]; then
    echo "BLOCKED commit: the commit-time entry .claude/hooks/pre_bash_dispatch.py is missing. Restore it (git checkout HEAD -- .claude/hooks/pre_bash_dispatch.py), then commit again." >&2
    exit 1
fi
if ! command -v python3 >/dev/null 2>&1; then
    echo "BLOCKED commit: the commit-msg hook cannot find python3 on PATH to run the commit checks. Put python3 on PATH, then commit again." >&2
    exit 1
fi
exec python3 "$entry" --commit-msg "$1"
