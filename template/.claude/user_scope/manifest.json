{"version": 1, "retired": [{"id": "large-read-reminder", "dest": "~/.claude/hooks/large_read_reminder.py", "event": "PostToolUse", "matcher": "Read", "command": "python {dest}"}], "items": [
 {"id": "statusline", "kind": "file", "src": "statusline.py", "dest": "~/.claude/statusline.py",
  "register": {"setting": "statusLine", "value": {"type": "command", "command": "python {dest}", "refreshInterval": 30}},
  "note": "refreshInterval repaints the warm countdown while a session is idle; 30 is the owner's operating value"}
]}
